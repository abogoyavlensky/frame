(ns frame.check
  (:require [frame.config :as config]
            [frame.generate :as generate]
            [frame.new :as new]
            [frame.prompt :as prompt]
            [frame.source :as source]
            [json]
            [string :as str]))

;; ---------------------------------------------------------------------------
;; `frame check`: render the template in memory for every valid combination of
;; answers and report what breaks. Never writes files.
;; ---------------------------------------------------------------------------

(def ^:private check-project-name "example-app")

;; ---------------------------------------------------------------------------
;; Enumeration
;; ---------------------------------------------------------------------------

(defn- branches
  "The values one applicable var takes across combinations."
  [var]
  (case (:type var)
    :enum (:options var)
    :boolean [true false]
    :string [(if (str/blank? (:default var)) "example" (:default var))]))

(defn- walk-vars [vars answers skipped]
  (if (empty? vars)
    [answers]
    (let [var (first vars)
          skey (name (:key var))]
      (if (prompt/applies? var answers skipped)
        (mapcat (fn [v] (walk-vars (rest vars) (assoc answers skey v) skipped))
                (branches var))
        (walk-vars (rest vars) (assoc answers skey (prompt/skipped-value var)) (conj skipped skey))))))

(defn combinations
  "Every valid combination of answers, as string-keyed maps, depth-first over
   the vars in declared order. A var skipped by :when contributes its skipped
   value and a single branch, so there are no duplicates."
  [config]
  (vec (walk-vars (:vars config) {} #{})))

;; ---------------------------------------------------------------------------
;; Rendering every combination
;; ---------------------------------------------------------------------------

(defn- check-one
  "Render one combination. Returns {:srcs [source paths generated]} or
   {:error message}."
  [repo-dir config answers]
  (let [res (try {:ok (let [vars (prompt/compute-vars
                                   config
                                   (assoc answers "project-name" check-project-name))
                            entries (generate/render-entries repo-dir vars config)]
                        (new/next-steps-lines config vars check-project-name)
                        (mapv :src entries))}
                 (catch e {:err (ex-message e)}))]
    (if (contains? res :err)
      {:error (:err res)}
      {:srcs (:ok res)})))

(defn- group-errors
  "Group failures by message, in first-seen order: [{:message :count :example}]."
  [failures]
  (let [order (distinct (map :message failures))
        by-msg (group-by :message failures)]
    (mapv (fn [m]
            (let [fs (get by-msg m)]
              {:message m
               :count (count fs)
               :example (:answers (first fs))}))
          order)))

(defn check-template
  "Render `config`'s template at repo-dir for every combination. Returns
   {:combinations [answers ...]
    :errors [{:message s :count n :example answers} ...]
    :never-generated [src ...]}
   :never-generated lists template source files no combination produces; it is
   only computed when there are no errors, since a failed combination's
   surviving files are unknown."
  [repo-dir config]
  (let [combos (combinations config)
        results (mapv (fn [answers] (assoc (check-one repo-dir config answers)
                                           :answers answers))
                      combos)
        failures (keep (fn [r] (when (:error r) {:message (:error r)
                                                 :answers (:answers r)}))
                       results)
        errors (group-errors failures)
        generated (set (mapcat :srcs results))]
    {:combinations combos
     :errors errors
     :never-generated (if (seq errors)
                        []
                        (vec (remove generated (generate/source-files repo-dir config))))}))

;; ---------------------------------------------------------------------------
;; Output
;; ---------------------------------------------------------------------------

(defn ok?
  "True when the check found no errors and no never-generated files."
  [result]
  (and (empty? (:errors result))
       (empty? (:never-generated result))))

(defn- applied-pairs
  "[\"key=value\" ...] for the vars that applied under `answers`, in declared
   order. Skipped vars are left out: `frame new` rejects a --var for them."
  [config answers]
  (let [skipped (prompt/skipped-keys (:vars config) answers)]
    (vec (keep (fn [v]
                 (let [skey (name (:key v))]
                   (when-not (contains? skipped skey)
                     (str skey "=" (get answers skey)))))
               (:vars config)))))

(defn format-human
  "Human-readable report for stdout."
  [src config result]
  (let [total (count (:combinations result))]
    (if (ok? result)
      (str "Checked " total " combinations of " src ": OK")
      (str/join
        "\n"
        (concat
          (mapcat (fn [e]
                    [(:message e)
                     (str "  in " (:count e) " of " total " combinations, e.g. "
                          (str/join " " (applied-pairs config (:example e))))])
                  (:errors result))
          (map (fn [f] (str "never generated in any combination: " f))
               (:never-generated result)))))))

(defn format-json
  "JSON report for stdout. Maps are built with keyword keys. `vars` is ready
   to pass to `frame new --defaults --var`."
  [config result]
  (json/write-json
    {:ok (ok? result)
     :count (count (:combinations result))
     :combinations (mapv (fn [answers]
                           {:answers (into {} (map (fn [[k v]] [(keyword k) v]) answers))
                            :vars (str/join "," (applied-pairs config answers))})
                         (:combinations result))
     :errors (mapv (fn [e]
                     {:message (:message e)
                      :count (:count e)
                      :example (str/join "," (applied-pairs config (:example e)))})
                   (:errors result))
     :never_generated (:never-generated result)}))

;; ---------------------------------------------------------------------------
;; Command
;; ---------------------------------------------------------------------------

(defn- run* [ctx]
  (let [src (get-in ctx [:args :source])
        template-dir (source/resolve-source! src)
        cfg (config/read-config template-dir)]
    (doseq [w (:warnings cfg)]
      (write! *err* (str "frame: warning: " w "\n")))
    (let [result (check-template template-dir cfg)]
      (println (if (get-in ctx [:opts :json?])
                 (format-json cfg result)
                 (format-human src cfg result)))
      (when-not (ok? result)
        (os/exit 1)))))

(defn cmd-check!
  "tiny-cli handler for `frame check`. Config and source errors are reported
   as `frame: <message>` on stderr (exit 1), like `frame new`."
  [ctx]
  (try (run* ctx)
       (catch e
              (write! *err* (str "frame: " (ex-message e) "\n"))
         (os/exit 1))))
