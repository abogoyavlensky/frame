(ns frame.config
  (:require [edn]
            [frame.template.parser :as parser]
            [frame.version :as version]))

;; ---------------------------------------------------------------------------
;; frame.edn reading and validation.
;;
;; read-config returns a normalized map with defaults applied:
;;   {:description s|nil :root "template" :vars [...] :computed {} :raw []
;;    :next-steps [] :warnings [s ...]}
;; :warnings lists unrecognized top-level keys; it never blocks generation.
;; Every failure throws ex-info {:reason :config ...} before any prompting.
;; ---------------------------------------------------------------------------

(def ^:private valid-types #{:string :enum :boolean})

(def ^:private known-keys
  #{:description :root :vars :computed :raw :next-steps :min-frame-version})

(def ^:private reserved-var-names #{"project-name" "now-date" "now-year"})

(defn- config-error [msg data]
  (throw (ex-info msg (assoc data :reason :config))))

(defn parse-semver
  "Parse an exact \"X.Y.Z\" semver string into [X Y Z] ints, or nil for
   anything else (wrong shape, extra components, non-strings)."
  [s]
  (when (string? s)
    (when-let [m (re-matches #"^(\d+)\.(\d+)\.(\d+)$" s)]
      (let [parts (vec (map parse-long (rest m)))]
        ;; parse-long returns nil on overflow, and nil compares as "older
        ;; than everything" — reject instead of silently passing the check.
        (when (every? some? parts)
          parts)))))

(defn check-min-version!
  "Throw {:reason :config} when min-version (a template's :min-frame-version)
   is malformed or newer than current. nil min-version is a no-op."
  [min-version current]
  (when (some? min-version)
    (let [required (parse-semver min-version)]
      (when (nil? required)
        (config-error (str ":min-frame-version must be an exact semver string like \"0.3.0\", got "
                           (pr-str min-version))
                      {:min-frame-version min-version}))
      (when (pos? (compare required (parse-semver current)))
        (config-error (str "template requires frame >= " min-version
                           ", but this is frame " current " (upgrade frame)")
                      {:min-frame-version min-version
                       :current current})))))

(defn- validate-var
  "Validate one :vars entry, returning it unchanged on success."
  [v]
  (let [k (:key v)]
    (when-not (keyword? k)
      (config-error "each var needs a keyword :key" {:var v}))
    ;; Answers are keyed by (name k), so a namespaced :x/now-date would
    ;; collide with the built-in all the same — compare the normalized name.
    (when (contains? reserved-var-names (name k))
      (config-error (str k " is reserved and cannot be declared in :vars")
                    {:var k}))
    (when-not (string? (:prompt v))
      (config-error (str "var " k " needs a string :prompt") {:var k}))
    (when-not (contains? valid-types (:type v))
      (config-error (str "var " k " has invalid :type " (pr-str (:type v))
                         " (expected :string, :enum, or :boolean)")
                    {:var k}))
    (when (= (:type v) :enum)
      (let [opts (:options v)]
        (when-not (and (vector? opts) (seq opts))
          (config-error (str "enum var " k " needs a non-empty :options vector")
                        {:var k}))
        (when (and (contains? v :default)
                   (not (contains? (set opts) (:default v))))
          (config-error (str "var " k " :default " (pr-str (:default v))
                             " is not one of its :options")
                        {:var k}))))
    v))

;; ---------------------------------------------------------------------------
;; :when validation. A condition may only reference vars declared before the
;; var that carries it, so the prompt loop can always evaluate it. Literal
;; operands are checked against the referenced var so a typo such as
;; `frontend == htmxx` fails at load instead of silently never matching.
;; ---------------------------------------------------------------------------

(defn- when-error [v msg]
  (config-error (str "var " (:key v) " :when" msg) {:var (:key v)}))

(defn- check-literal!
  "A literal compared against known var `ref-var` must be one of its options
   (enum) or true/false (boolean). String vars accept anything."
  [v ref-var lit]
  (case (:type ref-var)
    :enum (when-not (contains? (set (:options ref-var)) lit)
            (when-error v (str ": " (pr-str lit) " is not an option of " (:key ref-var))))
    :boolean (when-not (contains? #{"true" "false"} lit)
               (when-error v (str ": " (pr-str lit) " is not true or false (" (:key ref-var)
                                  " is boolean)")))
    nil))

(defn- check-cmp
  "Returns the set of known names referenced by a comparison node."
  [v known node]
  (let [side (fn [t]
               {:term t
                :var (when (= (:kind t) :ident) (get known (:value t)))})
        l (side (:left node))
        r (side (:right node))]
    (when-not (or (:var l) (:var r))
      (when-error v (str " compares two literals: " (pr-str (:when v)))))
    (doseq [[known-side lit-side] [[l r] [r l]]]
      (when (and (:var known-side) (not (:var lit-side)))
        (check-literal! v (:var known-side) (:value (:term lit-side)))))
    (set (map (fn [x] (:value (:term x))) (filter :var [l r])))))

(defn- check-when-node [v known node]
  (case (:op node)
    (:or :and) (into (check-when-node v known (:left node))
                     (check-when-node v known (:right node)))
    :not (check-when-node v known (:expr node))
    :cmp (check-cmp v known node)
    :term (cond
            (= (:kind node) :str) #{}
            (contains? known (:value node)) #{(:value node)}
            :else (when-error v (str " references unknown or later var "
                                     (pr-str (:value node)))))))

(defn- validate-when
  "Parse and check v's :when against `earlier` (the vars declared before it).
   Returns v with :when-cond (the AST) and :when-refs (set of referenced var
   names) added; a var without :when is returned unchanged."
  [v earlier]
  (if-not (contains? v :when)
    v
    (let [src (:when v)
          _ (when-not (string? src)
              (when-error v (str " must be a string, got " (pr-str src))))
          ast (try (parser/parse-cond src)
                   (catch e
                          (config-error (str "var " (:key v) " has invalid :when "
                                             (pr-str src) ": " (ex-message e))
                                        {:var (:key v)})))
          known (into {} (map (fn [e] [(name (:key e)) e]) earlier))]
      (assoc v
             :when-cond ast
             :when-refs (check-when-node v known ast)))))

(defn normalize-vars
  "Validate every var in declaration order and attach :when-cond/:when-refs to
   those with a :when. Returns the vector of normalized vars."
  [vars]
  (reduce (fn [acc v] (conj acc (validate-when (validate-var v) acc)))
          []
          vars))

(defn- validate-next-steps [steps]
  (when-not (and (vector? steps) (every? string? steps))
    (config-error (str ":next-steps must be a vector of strings, got " (pr-str steps))
                  {:next-steps steps}))
  steps)

(defn read-config
  "Read and validate <dir>/frame.edn. Returns the normalized config map or
   throws ex-info {:reason :config ...}."
  [dir]
  (let [f (str dir "/frame.edn")]
    (when-not (file-exists? f)
      (config-error (str "frame.edn not found in " dir) {:dir dir}))
    ;; Wrap in a vector so ALL top-level forms are read: this rejects trailing
    ;; data (e.g. leftover merge-conflict text) that read-string would ignore.
    (let [forms (try (edn/read-string (str "[" (slurp f) "]"))
                     (catch e
                            (config-error (str "could not parse frame.edn: " (ex-message e))
                                          {:dir dir})))]
      (when-not (= 1 (count forms))
        (config-error "frame.edn must contain exactly one top-level map" {:dir dir}))
      (let [raw (first forms)]
        (when-not (map? raw)
          (config-error "frame.edn must contain a map" {:dir dir}))
        ;; Version first: a too-new template should say "upgrade frame", not
        ;; trip over whatever newer config feature it also uses.
        (check-min-version! (:min-frame-version raw) version/current)
        {:description (:description raw)
         :root (or (:root raw) "template")
         :vars (normalize-vars (or (:vars raw) []))
         :computed (or (:computed raw) {})
         :raw (or (:raw raw) [])
         :next-steps (validate-next-steps (if (contains? raw :next-steps) (:next-steps raw) []))
         ;; Keys may be any EDN value, so render and sort via pr-str.
         :warnings (vec (map (fn [k] (str "unrecognized key " (pr-str k) " in frame.edn"))
                             (sort-by pr-str (remove known-keys (keys raw)))))}))))
